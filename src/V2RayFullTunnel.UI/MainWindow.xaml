<Window x:Class="V2RayFullTunnel.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="V2Ray Full Tunnel" Height="620" Width="900"
        FlowDirection="LeftToRight" WindowStartupLocation="CenterScreen"
        Background="#F4F6F9" WindowStyle="SingleBorderWindow">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="14,14,14,8">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="16" Margin="0,0,0,12">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" x:Name="StatusDot" Width="14" Height="14" CornerRadius="7"
                  Background="#C3C9D2" VerticalAlignment="Center" Margin="0,0,12,0"/>
          <StackPanel Grid.Column="1">
            <TextBlock x:Name="StatusTitle" Text="Ready to connect" FontSize="19" FontWeight="SemiBold" Foreground="#16202B"/>
            <TextBlock x:Name="StatusSub" Text="Select a saved profile and press Connect." Margin="0,4,0,0"
                       Foreground="#6B7684" TextWrapping="Wrap"/>
          </StackPanel>
          <ProgressBar Grid.Column="2" x:Name="BusyBar" Width="120" Height="5" IsIndeterminate="True"
                       VerticalAlignment="Center" Visibility="Collapsed" Foreground="#2D6CDF"/>
        </Grid>
      </Border>

      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="320"/>
          <ColumnDefinition Width="14"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="14">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Saved profiles" FontWeight="SemiBold" FontSize="13"
                       Foreground="#16202B" Margin="0,0,0,10"/>

            <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
              <TextBox x:Name="NameBox" Height="34" Padding="10,6" VerticalContentAlignment="Center"
                       TextChanged="OnNameChanged" KeyDown="OnNameKeyDown"/>
              <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="6"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="6"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" x:Name="SaveBtn" Content="Save" Height="34" Click="OnSaveProfile"
                        Background="#2D6CDF" Foreground="White" BorderThickness="0" Cursor="Hand"
                        Style="{StaticResource FlatButton}"/>
                <Button Grid.Column="2" x:Name="EditBtn" Content="Update" Height="34" Click="OnUpdateProfile"
                        Background="#EEF1F5" Foreground="#16202B" BorderThickness="0" Cursor="Hand"
                        IsEnabled="False" Style="{StaticResource FlatButton}"/>
                <Button Grid.Column="4" x:Name="DefaultBtn" Content="Default" Height="34" Click="OnSetDefault"
                        Background="#E8F1FF" Foreground="#1B4FA8" BorderThickness="0" Cursor="Hand"
                        IsEnabled="False" Style="{StaticResource FlatButton}"/>
              </Grid>
              <Button x:Name="DeleteBtn" Content="Delete selected" Height="34" Margin="0,8,0,0"
                      Click="OnDeleteProfile" Background="#FDECEA" Foreground="#B3261E"
                      BorderThickness="0" Cursor="Hand" IsEnabled="False" Style="{StaticResource FlatButton}"/>
            </StackPanel>

            <ListBox x:Name="ProfileList" SelectionChanged="OnProfileSelected" BorderThickness="0"
                     Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                  <Setter Property="Padding" Value="8,6"/>
                  <Setter Property="Margin" Value="0,0,0,4"/>
                  <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
              </ListBox.ItemContainerStyle>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel>
                    <TextBlock Text="{Binding Display}" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="#16202B"/>
                    <TextBlock Text="{Binding Details}" FontSize="11" Foreground="#8A93A0"
                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </Border>

        <Grid Grid.Column="2">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="14">
            <StackPanel>
              <TextBlock x:Name="LinkLabel" Text="Profile link - paste a new VLESS / VMess / Trojan link here"
                         Foreground="#6B7684" FontSize="12" Margin="0,0,0,8"/>
              <TextBox x:Name="LinkBox" Height="66" AcceptsReturn="True" TextWrapping="Wrap"
                       VerticalScrollBarVisibility="Auto" Padding="10" FontFamily="Consolas" FontSize="12"
                       TextChanged="OnLinkChanged"/>
            </StackPanel>
          </Border>

          <UniformGrid Grid.Row="2" Columns="3" Margin="0,0,0,12">
            <Button x:Name="ConnectBtn" Content="Connect" Height="40" Margin="0,0,6,0" Click="OnConnect"
                    Background="#2D6CDF" Foreground="White" BorderThickness="0" Cursor="Hand"
                    Style="{StaticResource FlatButton}"/>
            <Button x:Name="DisconnectBtn" Content="Disconnect" Height="40" Margin="3,0" Click="OnDisconnect"
                    Background="#EEF1F5" Foreground="#16202B" BorderThickness="0" Cursor="Hand"
                    IsEnabled="False" Style="{StaticResource FlatButton}"/>
            <Button x:Name="CheckIpBtn" Content="Check IP" Height="40" Margin="6,0,0,0" Click="OnCheckIp"
                    Background="#EEF1F5" Foreground="#16202B" BorderThickness="0" Cursor="Hand"
                    Style="{StaticResource FlatButton}"/>
          </UniformGrid>

          <Border Grid.Row="3" Background="#171E29" CornerRadius="12" Padding="12">
            <TextBox x:Name="LogBox" IsReadOnly="True" Background="Transparent" Foreground="#C9D3DF"
                     BorderThickness="0" FontFamily="Consolas" FontSize="12"
                     VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap"/>
          </Border>
        </Grid>
      </Grid>
    </Grid>

    <Border Grid.Row="1" Background="#E9ECF1" Padding="14,7">
      <DockPanel>
        <TextBlock DockPanel.Dock="Right" Text="Design by Soheil Saleh - All rights reserved"
                   Foreground="#6B7684" FontSize="11"/>
        <TextBlock x:Name="FooterNote" Text="Closing the window keeps the app in the system tray. Disconnect restores the network."
                   Foreground="#8A93A0" FontSize="11"/>
      </DockPanel>
    </Border>
  </Grid>
</Window>